rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Administrador: a conta principal da Beira vê e altera tudo.
    function dono() {
      return request.auth != null
        && request.auth.token.email == 'admin@beira-oficina.mz';
    }
    // Colaborador: existe em /acessos/{e-mail} e está ativo.
    function acesso() {
      return get(/databases/$(database)/documents/acessos/$(request.auth.token.email)).data;
    }
    function colaborador() {
      return request.auth != null
        && exists(/databases/$(database)/documents/acessos/$(request.auth.token.email))
        && acesso().ativo != false;
    }

    // Lista de utilizadores: só o administrador escreve; cada colaborador lê o seu registo.
    match /acessos/{email} {
      allow read: if dono() || (request.auth != null && request.auth.token.email == email);
      allow write: if dono();
    }

    // Ordens de serviço e estoque: o colaborador trabalha, só o administrador apaga.
    match /os/{id} {
      allow read, create, update: if dono() || colaborador();
      allow delete: if dono();
    }
    match /estoque/{id} {
      allow read, create, update: if dono() || colaborador();
      allow delete: if dono();
    }

    // Fotos das viaturas.
    match /fotos/{id} {
      allow read, create, delete: if dono() || colaborador();
    }

    // Aparelhos para notificações push: cada um regista o seu; só o administrador os lê.
    match /dispositivos/{id} {
      allow create, update: if dono() || colaborador();
      allow read, delete: if dono();
    }

    // Todo o resto (marca do administrador, avisos enviados, ...): só o administrador.
    // A conta de serviço do robô de avisos ignora estas regras.
    match /{document=**} {
      allow read, write: if dono();
    }
  }
}
